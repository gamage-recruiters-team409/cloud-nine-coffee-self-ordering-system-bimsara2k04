# PostgreSQL
DATABASE_URL="postgresql://cloud_nine:cloud_nine@localhost:5434/cloud_nine?schema=public"

# Backend
PORT=3001
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:3000"
# When the frontend is on Vercel, append its domain (comma-separated):
# CORS_ORIGIN="http://localhost:3000,https://your-app.vercel.app"
# Frontend app URL — used for PayHere return/cancel redirects and QR tracking links
# When the frontend is on Vercel, set this to the Vercel URL:
# PUBLIC_URL="https://your-app.vercel.app"
PUBLIC_URL="http://localhost:3000"
TRACKING_TOKEN_EXPIRES_HOURS="24"

# PayHere (SANDBOX ONLY — never add live credentials to this repo)
# Merchant ID and secret come from https://sandbox.payhere.lk/merchant/register
PAYHERE_MERCHANT_ID="sandbox-merchant-id"
PAYHERE_MERCHANT_SECRET="sandbox-merchant-secret"
# Sandbox mode. Set to "false" only if you intentionally point at live checkout.
PAYHERE_SANDBOX="true"
# Backend public base URL — must be reachable by PayHere for notify_url.
# Use a tunnel (e.g. ngrok/cloudflared) for real sandbox testing.
BACKEND_URL="http://localhost:3001"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
